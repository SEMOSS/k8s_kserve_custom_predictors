ARG BASE_IMAGE=cfg-ms-base-flash:latest
FROM ${BASE_IMAGE}
WORKDIR /app

# Bring in the updated manifests produced outside Docker:
COPY common/base/flash/pyproject.toml pyproject.toml
COPY common/base/flash/poetry.lock   poetry.lock

# Install exactly what’s in the lockfile; no upgrades.
RUN poetry install --no-interaction --no-ansi --no-root --sync

COPY common/kserve/torch /app/kserve-torch/
RUN pip install -e /app/kserve-torch/ --no-deps
RUN python -c "import torch, flash_attn; print(torch.__version__, flash_attn.__version__)"